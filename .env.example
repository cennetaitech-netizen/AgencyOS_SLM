# Copy to .env for local development. Never commit real secrets.
CHAT_ENV=dev
CHAT_DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5432/chat_dev
CHAT_BILLING_MODE=shadow

# Model host (any OpenAI-compatible API: vLLM, Ollama, Together, Fireworks, ...)
CHAT_MODEL_BASE_URL=http://localhost:11434/v1
CHAT_MODEL_NAME=qwen3:8b
CHAT_MODEL_API_KEY=
# Chosen production candidate (Together AI, Qwen2.5-7B-Instruct):
# CHAT_MODEL_BASE_URL=https://api.together.xyz/v1
# CHAT_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct-Turbo
# CHAT_MODEL_API_KEY=<from the secrets manager>
# CHAT_MODEL_FALLBACK_BASE_URL=
# CHAT_MODEL_FALLBACK_NAME=
# CHAT_MODEL_FALLBACK_API_KEY=
# Prefix caching on the model host: see ops/MODEL_HOST.md. Price per 1M prompt tokens served from its cache
# (unset = priced like other input tokens, which overstates cost):
# CHAT_HOST_PRICE_CACHED_INPUT_PER_1M_MINOR=
# Prompt versions (defaults: system_v3 / system_v3_actions; use system_ft_v2 for the fine-tuned model):
# CHAT_PROMPT_VERSION=system_v3
# CHAT_PROMPT_VERSION_ACTIONS=system_v3_actions
# Where the [Context] line goes: user_prefix (default) or system_message (see docs/chat/PROMPT_V3_LOCAL_EVAL.md)
# CHAT_PROMPT_CONTEXT_PLACEMENT=user_prefix

# Product (mock until Phase 0 maps the real API)
CHAT_PRODUCT_ADAPTER=mock
CHAT_PRODUCT_API_BASE_URL=http://localhost:8000
CHAT_AUTH_PROVIDER=dev

# Payments. "manual" = no online payments: pack orders show payment instructions, staff confirm them when the money
# arrives, and staff mark invoices paid (enough for launch). "dev" = fake online provider for development only.
# CHAT_PAYMENT_PROVIDER=manual
# CHAT_MANUAL_PAYMENT_INSTRUCTIONS="We'll email you an invoice. Pay by bank transfer and quote the order reference; your tokens are added as soon as the payment arrives."
# Only used by an online provider:
CHAT_PAYMENT_WEBHOOK_SECRET=change-me

# Production hardening (required when CHAT_ENV=production; the service refuses to start without them)
# CHAT_CORS_ALLOWED_ORIGINS=["https://app.agencyos.example"]
# CHAT_REDIS_URL=redis://redis:6379/0            # run this Redis without persistence
# CHAT_DATA_ENCRYPTION_KEYS=["<python -m chat_service.crypto genkey>"]
# CHAT_METRICS_TOKEN=<random>
# CHAT_BILLING_TOKENIZER_PATH=/srv/billing/tokenizer_v1.json
